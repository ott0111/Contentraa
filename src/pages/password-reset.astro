---
import Base from "@/layouts/Base.astro";
---

<Base
  title="Password Reset | Contentra"
  meta_title="Password Reset | Contentra"
  description="Contentra account recovery will be available when workspace accounts launch."
>
  <section class="page-hero pb-14 pt-16">
    <div class="container">
      <div class="mx-auto max-w-[640px] text-center">
        <h1 class="mb-6">Account recovery isn’t available yet.</h1>
        <p class="text-lg">Contentra sign-in and account recovery have not launched. No password reset emails can be sent from this site yet.</p>
        <a class="btn btn-primary mt-8" href="/signup">Ask about early access</a>
      </div>
    </div>
  </section>
</Base>