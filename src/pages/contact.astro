---
import Base from "@/layouts/Base.astro";
import config from "@/config/config.json";

const email = config.params.email;
---

<Base
  title="Contact Contentra"
  meta_title="Contact Contentra"
  description="Get in touch with the Contentra team about the product, feedback, or partnerships."
>
  <section class="page-hero pb-14 pt-16">
    <div class="container">
      <div class="mx-auto max-w-[760px] text-center">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.16em] text-primary">Contact</p>
        <h1 class="mb-6">Let’s talk about Contentra.</h1>
        <p class="text-lg">Questions, feedback, or interested in following the product as it develops? Send us an email and we’ll take it from there.</p>
        <a class="btn btn-primary mt-8" href={`mailto:${email}?subject=Hello%20Contentra`}>Email Contentra</a>
        <p class="mt-4 text-sm text-text-light">{email}</p>
      </div>
    </div>
  </section>
</Base>