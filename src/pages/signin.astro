---
import Base from "@/layouts/Base.astro";
import config from "@/config/config.json";

const email = config.params.email;
---

<Base
  title="Contentra Sign In"
  meta_title="Sign In | Contentra"
  description="The Contentra workspace sign-in experience is not available yet."
>
  <section class="page-hero pb-14 pt-16">
    <div class="container">
      <div class="mx-auto max-w-[640px] text-center">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.16em] text-primary">Workspace access</p>
        <h1 class="mb-6">The workspace isn’t open yet.</h1>
        <p class="text-lg">We’re building Contentra’s account and workspace experience now. Sign-in is not enabled yet, so there’s no need to enter a password on this page.</p>
        <a class="btn btn-primary mt-8" href={`mailto:${email}?subject=Contentra%20Workspace%20Access`}>Contact Contentra</a>
        <p class="mt-6 text-sm text-text-light">New to Contentra? <a class="underline" href="/signup">Ask about early access</a>.</p>
      </div>
    </div>
  </section>
</Base>