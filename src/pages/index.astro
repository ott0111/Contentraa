---
import Base from "@/layouts/Base.astro";
---

<Base title="Contentra — The Operating System for Creators" meta_title="Contentra — Your next stage of growth starts here" description="Connect your brand, discover opportunities, create better content, and build a smarter growth system with Contentra.">
  <div class="contentra-home">
    <section class="hero section">
      <div class="container hero-grid">
        <div class="hero-copy">
          <div class="eyebrow"><span class="eyebrow-dot"></span> THE OPERATING SYSTEM FOR CREATORS</div>
          <h1>Your next stage of growth <span>starts here.</span></h1>
          <p class="hero-lede">Connect your brand, discover opportunities, create content, and build a smarter growth system with Contentra.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="/signup">Get started <span aria-hidden="true">↗</span></a>
            <a class="button button-secondary" href="#platform">Explore the platform <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-note"><span class="check">✓</span> One connected workspace. A clearer next step.</div>
        </div>
        <div class="product-stage" aria-label="Illustrative preview of the Contentra workspace">
          <div class="stage-orbit orbit-one"></div><div class="stage-orbit orbit-two"></div>
          <div class="app-window">
            <div class="app-topbar"><div class="mini-brand"><span class="mini-mark">c</span> contentra</div><div class="topbar-right"><span class="workspace-pill"><span class="tiny-avatar">S</span> Studio workspace⌄</span><span class="avatar">Y</span></div></div>
            <div class="app-body">
              <aside class="app-sidebar">
                <div class="side-label">WORKSPACE</div>
                <div class="side-link selected"><span>⌂</span> Overview</div><div class="side-link"><span>◈</span> Brand Brain</div><div class="side-link"><span>⌕</span> Discover</div><div class="side-link"><span>✳</span> Creatos</div><div class="side-link"><span>✎</span> Create</div><div class="side-link"><span>▤</span> My Content</div><div class="side-link"><span>▦</span> Planner</div><div class="side-link"><span>⌁</span> Analytics</div>
                <div class="side-bottom"><span>⚙</span> Settings</div>
              </aside>
              <div class="app-main">
                <div class="app-welcome"><div><span class="app-kicker">YOUR GROWTH WORKSPACE</span><h3>Make your next move.</h3><p>Your brand, ideas, and next steps in one place.</p></div><span class="create-chip">＋ Create content</span></div>
                <div class="preview-metrics"><div class="preview-metric"><span>BRAND CONTEXT</span><strong>Ready to build</strong><small><i class="status-dot"></i> Brand Brain setup</small></div><div class="preview-metric"><span>CONTENT PIPELINE</span><strong>Stay organized</strong><small>Drafts · ideas · schedule</small></div><div class="preview-metric"><span>NEXT BEST ACTION</span><strong>Find your focus</strong><small>Recommendations with context</small></div></div>
                <div class="preview-columns"><div class="preview-panel"><div class="panel-heading"><div><b>Next best action</b><small>A useful next step, not another generic tip.</small></div><span class="spark">✳</span></div><div class="action-box"><span class="action-label">START WITH YOUR BRAND</span><b>Build your Brand Brain</b><p>Give Contentra the context it needs to tailor ideas to your audience and goals.</p><span class="action-link">Set up Brand Brain <span>→</span></span></div></div><div class="preview-panel opportunity-panel"><div class="panel-heading"><div><b>Opportunity board</b><small>Ideas worth exploring</small></div><span class="text-arrow">View all →</span></div><div class="opportunity"><span class="op-icon orange-icon">↗</span><div><b>Audience questions</b><small>Turn a real question into a useful post.</small></div></div><div class="opportunity"><span class="op-icon purple-icon">▧</span><div><b>Content repurposing</b><small>Find another format for an existing idea.</small></div></div><div class="opportunity"><span class="op-icon green-icon">◌</span><div><b>Content consistency</b><small>Build a schedule you can maintain.</small></div></div></div></div>
                <div class="app-footnote"><span class="footnote-mark">✳</span> Brand context → relevant ideas → content you can act on</div>
              </div>
            </div>
          </div>
          <div class="floating-note note-top"><span class="note-icon">✳</span><div><b>Context-aware AI</b><small>Built around your brand</small></div></div>
          <div class="floating-note note-bottom"><span class="note-check">✓</span><div><b>From idea to action</b><small>One connected workflow</small></div></div>
        </div>
      </div>
      <div class="hero-bottom container"><span>BUILT FOR THE WAY YOU GROW</span><div><span>Creators</span><i></i><span>Personal brands</span><i></i><span>Businesses</span><i></i><span>Agencies</span></div></div>
    </section>

    <section class="section workflow" id="platform">
      <div class="container">
        <div class="section-intro centered"><div class="eyebrow">A BETTER WAY TO GROW</div><h2>Stop guessing what to post.<br/><span>Start building with a system.</span></h2><p>Contentra connects the work behind good content, from understanding your brand to learning from what performs.</p></div>
        <div class="workflow-grid">
          <article class="workflow-step"><span class="step-number">01</span><div class="step-icon orange-icon">◈</div><h3>Understand</h3><p>Give Contentra a clear picture of your brand, audience, voice, and goals.</p><span class="step-link">Brand Brain</span></article>
          <article class="workflow-step"><span class="step-number">02</span><div class="step-icon violet-icon">⌕</div><h3>Discover</h3><p>Explore relevant topics, audience questions, and opportunities worth testing.</p><span class="step-link">Discover</span></article>
          <article class="workflow-step"><span class="step-number">03</span><div class="step-icon blue-icon">✳</div><h3>Create</h3><p>Turn a promising idea into original, on-brand scripts, posts, and briefs.</p><span class="step-link">Create studio</span></article>
          <article class="workflow-step"><span class="step-number">04</span><div class="step-icon green-icon">▦</div><h3>Organize</h3><p>Keep your drafts, assets, campaigns, and publishing plans together.</p><span class="step-link">My Content + Planner</span></article>
          <article class="workflow-step"><span class="step-number">05</span><div class="step-icon amber-icon">⌁</div><h3>Improve</h3><p>Use available performance data to understand results and choose what to do next.</p><span class="step-link">Analytics + insights</span></article>
        </div>
      </div>
    </section>

    <section class="section intelligence">
      <div class="container split-grid">
        <div class="split-copy"><div class="eyebrow">YOUR BRAND IS THE CONTEXT</div><h2>AI that starts with <span>your brand.</span></h2><p>Generic prompts produce generic content. Brand Brain gives Contentra a shared understanding of what you do, who you serve, how you sound, and what you're working toward.</p><ul class="benefit-list"><li><span>✓</span><div><b>Your voice, not a template</b><small>Keep your tone, positioning, and content preferences in context.</small></div></li><li><span>✓</span><div><b>One source of brand knowledge</b><small>Reuse approved context across creation, research, and recommendations.</small></div></li><li><span>✓</span><div><b>You stay in control</b><small>Review, edit, and update what Contentra knows about your brand.</small></div></li></ul><a class="text-link" href="/features">Explore the platform <span>→</span></a></div>
        <div class="brain-card"><div class="brain-header"><div><span class="card-eyebrow">BRAND BRAIN</span><h3>Your brand, understood.</h3></div><span class="brain-status"><i></i> Profile workspace</span></div><div class="brain-profile"><div class="brand-avatar">S</div><div><b>Your brand profile</b><small>Review and approve your brand context</small></div><span class="edit-pill">Edit profile</span></div><div class="brain-field"><div><span>01</span><b>Positioning</b></div><p>What makes your brand different and what you want to be known for.</p><div class="field-line"><i style="width:78%"></i></div></div><div class="brain-field"><div><span>02</span><b>Audience</b></div><p>The people you serve, their needs, and the questions they ask.</p><div class="field-line"><i style="width:61%"></i></div></div><div class="brain-field"><div><span>03</span><b>Voice & style</b></div><p>Your tone, preferred language, and examples to learn from.</p><div class="field-line"><i style="width:88%"></i></div></div><div class="brain-footer"><span class="tiny-shield">✓</span> You can review and change your brand context at any time.</div></div>
      </div>
    </section>

    <section class="section studio-section">
      <div class="container studio-grid">
        <div class="studio-visual"><div class="studio-window"><div class="studio-window-top"><span class="window-dots"><i></i><i></i><i></i></span><span>CREATE STUDIO</span><span class="draft-state">Draft workspace</span></div><div class="studio-editor"><div class="editor-label">SHORT-FORM SCRIPT <span>Brand context on</span></div><div class="editor-title">Give your next idea a strong opening.</div><div class="script-line strong-line"></div><div class="script-line"></div><div class="script-line short-line"></div><div class="script-highlight"><span>HOOK OPTION A</span><b>Start with the problem your audience already cares about.</b><small>Review and make it your own.</small></div><div class="script-line"></div><div class="script-line short-line"></div><div class="editor-actions"><span>↶ Undo</span><span>✳ Refine hook</span><span class="save-action">Save draft ↗</span></div></div></div><div class="studio-side-note"><span class="side-note-icon">✎</span><b>One editor, multiple workflows.</b><small>Create from scratch or start with a saved opportunity.</small></div></div>
        <div class="split-copy"><div class="eyebrow">FROM IDEA TO ASSET</div><h2>Make content.<br/><span>Keep the momentum.</span></h2><p>Bring ideas into one flexible studio. Generate a first draft, refine the parts that need work, save what you like, and move it into your content workflow.</p><div class="studio-feature-list"><div><span>01</span><b>Scripts, posts, hooks, and briefs</b></div><div><span>02</span><b>Brand-aware rewrites and variations</b></div><div><span>03</span><b>Saved drafts that stay organized</b></div><div><span>04</span><b>Remix a source into an original angle</b></div></div><a class="text-link" href="/features">See creation workflows <span>→</span></a></div>
      </div>
    </section>

    <section class="section audience-section">
      <div class="container"><div class="section-intro centered"><div class="eyebrow">ONE PLATFORM, DIFFERENT WORKFLOWS</div><h2>Built around the way <span>you work.</span></h2><p>Choose the workspace that fits you. Contentra adapts the context and workflows without splitting the product into separate tools.</p></div><div class="audience-grid"><article><div class="audience-icon orange-icon">↗</div><h3>Creators</h3><p>Find ideas, develop scripts, and build a more consistent content habit.</p><a href="/signup">Build your workflow <span>→</span></a></article><article><div class="audience-icon violet-icon">◉</div><h3>Personal brands</h3><p>Share expertise, sharpen your point of view, and build authority over time.</p><a href="/signup">Build your workflow <span>→</span></a></article><article><div class="audience-icon blue-icon">▥</div><h3>Businesses</h3><p>Connect content to your positioning, offers, campaigns, and goals.</p><a href="/signup">Build your workflow <span>→</span></a></article><article><div class="audience-icon green-icon">▦</div><h3>Agencies</h3><p>Organize client-specific context, content operations, and reporting as those features become available.</p><a href="/pricing">Explore plans <span>→</span></a></article></div></div>
    </section>

    <section class="section action-section">
      <div class="container action-panel"><div class="action-copy"><div class="eyebrow light-eyebrow">MAKE THE NEXT MOVE COUNT</div><h2>Less guessing.<br/>More intentional growth.</h2><p>Build a better process for the content you're creating and the decisions behind it.</p><a class="button button-light" href="/signup">Get started with Contentra <span>↗</span></a></div><div class="action-orb orb-a"></div><div class="action-orb orb-b"></div><div class="action-mark">c<span>.</span></div></div>
    </section>
    <section class="section faq-section"><div class="container faq-grid"><div class="section-intro"><div class="eyebrow">GOOD TO KNOW</div><h2>Questions, <span>answered.</span></h2><p>Contentra is designed to connect your growth workflow, not replace your judgment.</p><a class="text-link" href="/contact">Still have a question? <span>→</span></a></div><div class="faq-list"><details><summary>Is Contentra just an AI writing tool?<span>+</span></summary><p>No. Content creation is one part of the platform. Contentra is designed to connect brand context, opportunity discovery, organization, planning, and performance insights in one workflow.</p></details><details><summary>Who is Contentra for?<span>+</span></summary><p>Creators, personal brands, businesses, and agencies. Workspace setup and workflows are intended to adapt to the way each type of user works.</p></details><details><summary>Can Contentra publish directly to social platforms?<span>+</span></summary><p>Publishing and analytics depend on the capabilities and permissions available through each platform's integrations. Contentra should clearly identify what is supported for each connected account.</p></details><details><summary>Does Contentra guarantee growth or virality?<span>+</span></summary><p>No. It helps you make more informed decisions and build a more consistent process. Results depend on your audience, content, execution, and other factors outside the platform's control.</p></details></div></div></section>
  </div>
</Base>

<style>
  :global(html){scroll-behavior:smooth;scroll-padding-top:100px}
  :global(body){background:#fff;color:#18181b}
  .contentra-home{--orange:#f47b20;--ink:#18181b;--muted:#696a73;--line:#e9e9ed;--soft:#faf9f7;font-family:var(--font-primary),Inter,ui-sans-serif,system-ui,sans-serif}
  .contentra-home .container{width:min(1200px,calc(100% - 48px));margin-inline:auto}
  .contentra-home .section{padding:104px 0}
  .hero{padding-top:80px!important;padding-bottom:28px!important;overflow:hidden;background:radial-gradient(ellipse at 80% 25%,rgba(244,123,32,.075),transparent 38%),#fff}
  .hero-grid{display:grid;grid-template-columns:.86fr 1.14fr;align-items:center;gap:36px;min-height:530px}
  .hero-copy{position:relative;z-index:2;padding-bottom:30px}
  .eyebrow{display:flex;align-items:center;gap:9px;color:#77747a;font-size:10px;letter-spacing:.15em;font-weight:750}
  .eyebrow-dot{width:7px;height:7px;background:var(--orange);border-radius:50%;box-shadow:0 0 0 4px #fff0e5}
  .hero h1{max-width:550px;margin:24px 0 22px;font-size:clamp(43px,5.15vw,68px);line-height:1.045;letter-spacing:-.065em;font-weight:720;color:var(--ink)}
  .hero h1 span,.section-intro h2 span,.split-copy h2 span{color:var(--orange)}
  .hero-lede{max-width:460px;color:#666770;font-size:17px;line-height:1.8}
  .hero-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:30px}
  .button{display:inline-flex;align-items:center;justify-content:center;gap:20px;min-height:48px;padding:0 19px;border-radius:10px;font-size:13px;font-weight:650;transition:transform .2s,background .2s,border-color .2s}
  .button:hover{transform:translateY(-2px)}
  .button-primary{background:var(--orange);color:#fff;box-shadow:0 7px 18px #f47b2026}
  .button-primary:hover{background:#e86b11;color:#fff}
  .button-secondary{background:#fff;border:1px solid #e6e4e1;color:#29292e}
  .button-secondary:hover{border-color:#f4a46a}
  .hero-note{display:flex;align-items:center;gap:9px;margin-top:23px;color:#7c7b82;font-size:11px}
  .check{display:grid;place-items:center;width:17px;height:17px;border-radius:50%;background:#eaf6ed;color:#2d9a58;font-size:10px}
  .product-stage{position:relative;min-width:0;padding:28px 0 46px 8px}
  .stage-orbit{position:absolute;border:1px solid #f3e7dc;border-radius:50%;pointer-events:none}
  .orbit-one{width:580px;height:580px;top:-45px;left:0}.orbit-two{width:475px;height:475px;top:8px;left:53px}
  .app-window{position:relative;z-index:1;border:1px solid #e7e5e1;border-radius:15px;background:#fff;box-shadow:0 25px 70px #28201813;overflow:hidden;transform:perspective(1200px) rotateY(-2deg)}
  .app-topbar{height:47px;border-bottom:1px solid #eeeef0;display:flex;align-items:center;justify-content:space-between;padding:0 13px}
  .mini-brand{font-size:12px;font-weight:750;letter-spacing:-.04em;display:flex;align-items:center;gap:6px}.mini-mark{display:grid;place-items:center;width:19px;height:19px;border-radius:6px;background:var(--orange);color:#fff;font-size:13px;font-weight:800}
  .topbar-right{display:flex;align-items:center;gap:10px}.workspace-pill{font-size:8px;color:#65656b;display:flex;align-items:center;gap:5px;border:1px solid #ecebed;border-radius:6px;padding:5px 7px}.tiny-avatar,.avatar{display:grid;place-items:center;background:#ffe4cf;color:#9d4b13;border-radius:50%;font-size:8px;font-weight:700;width:16px;height:16px}.avatar{width:22px;height:22px;background:#29292e;color:white}
  .app-body{display:grid;grid-template-columns:132px 1fr;min-height:362px}.app-sidebar{position:relative;padding:15px 8px;border-right:1px solid #f0eff1;background:#fdfdfd}.side-label{font-size:7px;letter-spacing:.12em;color:#a0a0a6;padding:0 8px 11px}.side-link{height:29px;display:flex;align-items:center;gap:8px;padding:0 8px;border-radius:6px;font-size:8px;color:#71717a;margin-bottom:3px}.side-link span{font-size:12px;width:13px;text-align:center}.side-link.selected{background:#fff0e5;color:#d96310;font-weight:700}.side-bottom{position:absolute;bottom:12px;left:16px;display:flex;gap:8px;align-items:center;font-size:8px;color:#777}
  .app-main{padding:20px 17px 12px;min-width:0;background:#fff}.app-welcome{display:flex;justify-content:space-between;gap:8px;align-items:flex-start}.app-kicker,.card-eyebrow{font-size:7px;letter-spacing:.13em;color:#a0a0a7;font-weight:750}.app-welcome h3{font-size:19px;letter-spacing:-.05em;margin:5px 0 3px;font-weight:720}.app-welcome p{font-size:8px;color:#81818a;margin:0}.create-chip{white-space:nowrap;background:var(--orange);color:#fff;border-radius:6px;padding:7px 9px;font-size:8px;font-weight:650}
  .preview-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:18px}.preview-metric{border:1px solid #eeedf0;border-radius:7px;padding:10px 8px;min-width:0}.preview-metric>span{font-size:6px;letter-spacing:.08em;color:#97969e;display:block}.preview-metric strong{display:block;font-size:10px;margin-top:7px;letter-spacing:-.02em}.preview-metric small{display:block;font-size:7px;color:#898891;margin-top:5px;white-space:normal}.status-dot{display:inline-block;width:5px;height:5px;border-radius:50%;background:#49b37b;margin-right:3px}
  .preview-columns{display:grid;grid-template-columns:1.02fr .98fr;gap:8px;margin-top:9px}.preview-panel{border:1px solid #eeedf0;border-radius:7px;padding:11px 9px;min-width:0}.panel-heading{display:flex;justify-content:space-between;gap:4px;align-items:flex-start}.panel-heading b{display:block;font-size:9px}.panel-heading small{display:block;font-size:7px;color:#93929a;margin-top:4px}.spark{color:var(--orange);font-size:15px}.action-box{background:#fff8f2;border:1px solid #ffe4cf;border-radius:6px;padding:10px;margin-top:10px}.action-label{display:block;font-size:6px;color:#c76820;letter-spacing:.09em;font-weight:750}.action-box>b{font-size:9px;display:block;margin-top:5px}.action-box p{font-size:7px;line-height:1.55;color:#77737a;margin:5px 0 8px}.action-link{display:flex;justify-content:space-between;font-size:7px;color:#d96310;font-weight:700}.text-arrow{font-size:7px;color:#d96310;white-space:nowrap}.opportunity{display:flex;gap:7px;align-items:center;padding:9px 0;border-bottom:1px solid #f0eff1}.opportunity:last-child{border:0;padding-bottom:0}.op-icon{flex:none;display:grid;place-items:center;width:24px;height:24px;border-radius:6px;font-size:11px}.orange-icon{background:#fff0e5;color:#e77520}.purple-icon,.violet-icon{background:#f0ebff;color:#7c5ce0}.green-icon{background:#e9f7ef;color:#26995b}.blue-icon{background:#eaf2ff;color:#4279d4}.amber-icon{background:#fff3d8;color:#b88013}.opportunity b{font-size:8px;display:block}.opportunity small{display:block;font-size:7px;line-height:1.45;color:#8b8991;margin-top:3px}.app-footnote{display:flex;gap:6px;align-items:center;font-size:7px;color:#77767d;margin-top:12px}.footnote-mark{color:var(--orange)}
  .floating-note{position:absolute;z-index:2;display:flex;align-items:center;gap:9px;padding:11px 13px;border:1px solid #eee7e1;background:#fff;border-radius:10px;box-shadow:0 10px 35px #2b1a0c12}.floating-note b,.floating-note small{display:block}.floating-note b{font-size:10px}.floating-note small{font-size:8px;color:#85838b;margin-top:3px}.note-top{top:5px;right:-8px}.note-bottom{bottom:13px;left:-16px}.note-icon,.note-check{display:grid;place-items:center;width:28px;height:28px;border-radius:8px;background:#fff0e5;color:var(--orange);font-size:15px}.note-check{background:#eaf7ef;color:#29965a}
  .hero-bottom{display:flex;align-items:center;justify-content:space-between;gap:20px;border-top:1px solid #eeece9;padding-top:22px;margin-top:27px;color:#9a989c;font-size:9px;letter-spacing:.1em}.hero-bottom>div{display:flex;align-items:center;gap:17px;color:#66656b;letter-spacing:0;font-size:11px}.hero-bottom i{width:3px;height:3px;border-radius:50%;background:#d7d3cf}
  .workflow{background:#fbfaf8}.section-intro{max-width:650px}.centered{text-align:center;margin:0 auto 45px}.centered .eyebrow{justify-content:center}.section-intro h2,.split-copy h2{font-size:clamp(34px,4vw,49px);line-height:1.12;letter-spacing:-.055em;margin:18px 0 16px;font-weight:720}.section-intro p,.split-copy>p{font-size:15px;line-height:1.8;color:#72717a;max-width:600px}.centered p{margin-inline:auto}
