---
const noindex = true;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#18181b" />
    <title>Contentra Workspace Preview</title>
    <meta name="description" content="A private visual preview of the Contentra product workspace." />
    <link rel="icon" href="/images/contentra-mark.svg" type="image/svg+xml" />
    <style>
      :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#18181b;background:#f7f7f8;font-synthesis:none;text-rendering:optimizeLegibility}
      *{box-sizing:border-box}body{margin:0}button,a{font:inherit}button{cursor:pointer}
      .shell{min-height:100vh;display:grid;grid-template-columns:236px minmax(0,1fr)}
      .sidebar{background:#fff;border-right:1px solid #e9e9ec;padding:22px 14px;display:flex;flex-direction:column;min-height:100vh}
      .brand{display:flex;align-items:center;gap:10px;padding:0 10px 26px;color:#18181b;text-decoration:none;font-weight:800;font-size:20px;letter-spacing:-.06em}
      .mark{width:31px;height:31px;border-radius:10px;background:#f47b20;color:#fff;display:grid;place-items:center;font-size:23px;line-height:1}
      .preview-label{font-size:10px;font-weight:800;letter-spacing:.11em;color:#a9510d;background:#fff0e4;border-radius:7px;padding:9px 10px;margin:0 7px 24px}
      .nav-label{font-size:9px;font-weight:800;color:#a1a1aa;letter-spacing:.14em;padding:0 12px 9px}
      .nav{display:grid;gap:4px}.nav button{border:0;background:transparent;color:#66666f;display:flex;align-items:center;gap:12px;padding:11px 12px;border-radius:9px;text-align:left;font-size:12px;font-weight:650}
      .nav button:hover{background:#fafafa;color:#18181b}.nav button.active{background:#fff0e5;color:#b8530b}
      .nav-icon{width:17px;text-align:center;font-size:15px}.side-bottom{margin-top:auto;border-top:1px solid #eeeef0;padding-top:16px}
      .profile{display:flex;align-items:center;gap:10px;padding:10px 8px}.avatar{width:33px;height:33px;border-radius:50%;display:grid;place-items:center;background:#fbe1cc;color:#93420c;font-size:12px;font-weight:800}.profile b{display:block;font-size:11px}.profile small{display:block;color:#8b8b93;font-size:10px;margin-top:3px}
      .main{min-width:0}.topbar{height:68px;background:#fff;border-bottom:1px solid #e9e9ec;display:flex;align-items:center;justify-content:space-between;padding:0 34px;gap:16px}
      .crumb{font-size:11px;color:#8a8a92}.crumb b{color:#303037}.top-actions{display:flex;align-items:center;gap:10px}.sample-pill{border:1px solid #f3d4bd;background:#fff8f2;color:#a64d0c;padding:7px 10px;border-radius:7px;font-size:10px;font-weight:750}
      .content{max-width:1280px;padding:34px;margin:auto}.eyebrow{font-size:10px;font-weight:800;letter-spacing:.12em;color:#c15b10}.heading-row{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:27px}
      h1{font-size:clamp(26px,3vw,34px);letter-spacing:-.055em;line-height:1.15;margin:9px 0 9px}.sub{font-size:13px;line-height:1.65;color:#777780;margin:0;max-width:600px}
      .primary{border:0;background:#f47b20;color:#fff;border-radius:9px;padding:12px 15px;font-size:11px;font-weight:800;white-space:nowrap}.primary:hover{background:#dd6814}
      .notice{display:flex;align-items:flex-start;gap:12px;padding:14px 16px;border:1px solid #f1d6c3;background:#fffaf6;border-radius:11px;margin-bottom:22px}.notice-icon{color:#b9550c;font-weight:900}.notice b{display:block;font-size:11px;margin-bottom:4px}.notice p{font-size:11px;color:#777780;line-height:1.6;margin:0}
      .metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-bottom:18px}.metric,.panel,.action-card{background:#fff;border:1px solid #e9e9ec;border-radius:12px}.metric{padding:18px}.metric-label{font-size:11px;color:#777780}.metric strong{display:block;font-size:25px;letter-spacing:-.04em;margin:12px 0 7px}.metric small{font-size:10px;color:#92929a}
      .dashboard-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(260px,.85fr);gap:16px}.panel{padding:20px;min-width:0}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:17px}.panel-head h2{font-size:13px;margin:0;letter-spacing:-.02em}.panel-head span{font-size:10px;color:#8c8c94}
      .next{border:1px solid #f0d4bf;background:linear-gradient(145deg,#fffaf6,#fff);border-radius:10px;padding:17px}.next-label{font-size:9px;font-weight:850;letter-spacing:.1em;color:#b9540d}.next h3{font-size:17px;letter-spacing:-.035em;line-height:1.35;margin:12px 0 8px}.next p{font-size:11px;color:#777780;line-height:1.65;margin:0 0 15px}.text-button{border:0;background:transparent;color:#b9540d;padding:0;font-size:11px;font-weight:800}
      .empty{border:1px dashed #dedee2;border-radius:10px;padding:22px;text-align:center}.empty-mark{margin:0 auto 12px;width:38px;height:38px;border-radius:12px;display:grid;place-items:center;background:#fff0e5;color:#bd5b0d;font-size:19px}.empty b{display:block;font-size:12px}.empty p{max-width:280px;margin:8px auto 14px;color:#888891;font-size:11px;line-height:1.6}
      .quick-actions{display:grid;gap:9px}.quick-actions button{display:flex;align-items:center;gap:11px;border:1px solid #ececef;border-radius:9px;background:#fff;padding:12px;text-align:left}.quick-actions button:hover{border-color:#f0b98f;background:#fffaf6}.quick-icon{width:30px;height:30px;display:grid;place-items:center;border-radius:8px;background:#fff0e5;color:#bd5b0d}.quick-actions b{display:block;font-size:11px}.quick-actions small{display:block;color:#888891;font-size:10px;margin-top:4px}
      .page-view{display:none}.page-view.active{display:block}.mobile-brand,.mobile-menu{display:none}
      @media(max-width:900px){.shell{grid-template-columns:200px minmax(0,1fr)}.topbar{padding:0 22px}.content{padding:25px 22px}.dashboard-grid{grid-template-columns:1fr}.sidebar{padding:18px 10px}}
      @media(max-width:650px){.shell{display:block}.sidebar{display:none;position:fixed;z-index:5;inset:0 auto 0 0;width:255px;box-shadow:12px 0 35px #00000012}.sidebar.open{display:flex}.topbar{height:60px;padding:0 16px}.mobile-brand{display:flex;align-items:center;gap:8px;font-size:16px;font-weight:800;letter-spacing:-.05em}.mobile-brand .mark{width:27px;height:27px;font-size:20px}.mobile-menu{display:inline-grid;place-items:center;border:1px solid #e7e7ea;border-radius:8px;background:#fff;width:34px;height:34px}.crumb{display:none}.top-actions{margin-left:auto}.sample-pill{font-size:9px;padding:7px}.content{padding:23px 15px}.heading-row{flex-direction:column;align-items:stretch}.heading-row .primary{align-self:flex-start}.metrics{grid-template-columns:1fr;gap:10px}.metric{padding:15px}.metric strong{font-size:22px;margin:8px 0 4px}.panel{padding:15px}.dashboard-grid{gap:12px}}
    </style>
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar" id="sidebar">
        <a href="/" class="brand"><span class="mark">c</span><span>contentra</span></a>
        <div class="preview-label">PRIVATE PRODUCT PREVIEW</div>
        <div class="nav-label">WORKSPACE</div>
        <nav class="nav" aria-label="Workspace preview navigation">
          <button class="active" data-view="home"><span class="nav-icon">⌂</span>Overview</button>
          <button data-view="brand"><span class="nav-icon">◈</span>Brand Brain</button>
          <button data-view="discover"><span class="nav-icon">⌕</span>Discover</button>
          <button data-view="create"><span class="nav-icon">✳</span>Create</button>
          <button data-view="content"><span class="nav-icon">▤</span>My Content</button>
          <button data-view="planner"><span class="nav-icon">▦</span>Planner</button>
          <button data-view="analytics"><span class="nav-icon">↗</span>Analytics</button>
        </nav>
        <div class="side-bottom">
          <nav class="nav"><button data-view="settings"><span class="nav-icon">⚙</span>Settings</button></nav>
          <div class="profile"><span class="avatar">Y</span><div><b>Preview workspace</b><small>Sample account</small></div></div>
        </div>
      </aside>
      <main class="main">
        <header class="topbar">
          <button class="mobile-menu" id="mobile-menu" aria-label="Open navigation" aria-expanded="false">☰</button>
          <a href="/" class="mobile-brand"><span class="mark">c</span>contentra</a>
          <div class="crumb">Workspace <span> / </span> <b id="crumb-current">Overview</b></div>
          <div class="top-actions"><span class="sample-pill">DEMO DATA · NOT CONNECTED</span></div>
        </header>
        <div class="content">
          <section class="page-view active" data-page="home">
            <div class="heading-row"><div><div class="eyebrow">YOUR GROWTH WORKSPACE</div><h1>Everything starts with clarity.</h1><p class="sub">Build your brand context first, then use it to guide ideas, content, and your next move.</p></div><button class="primary" data-go="brand">Set up Brand Brain <span aria-hidden="true">↗</span></button></div>
            <div class="notice"><span class="notice-icon">i</span><div><b>This is a design preview</b><p>Numbers and examples on this screen are placeholders. Accounts, publishing, billing, and analytics are not connected in this preview.</p></div></div>
            <div class="metrics">
              <article class="metric"><div class="metric-label">Brand profile</div><strong>Not set up</strong><small>Your positioning, voice, audience, and goals</small></article>
              <article class="metric"><div class="metric-label">Content library</div><strong>Ready to build</strong><small>Your drafts and approved content in one place</small></article>
              <article class="metric"><div class="metric-label">Next best action</div><strong>Start with context</strong><small>Recommendations need brand and performance data</small></article>
            </div>
            <div class="dashboard-grid">
              <section class="panel"><div class="panel-head"><h2>Start with the essentials</h2><span>Suggested setup</span></div><div class="quick-actions">
                <button data-go="brand"><span class="quick-icon">◈</span><span><b>Build your Brand Brain</b><small>Define your audience, voice, offer, and goals</small></span></button>
                <button data-go="discover"><span class="quick-icon">⌕</span><span><b>Explore content opportunities</b><small>Review topics and angles that fit your niche</small></span></button>
                <button data-go="create"><span class="quick-icon">✳</span><span><b>Create your first draft</b><small>Turn an idea into a usable starting point</small></span></button>
              </div></section>
              <section class="panel"><div class="panel-head"><h2>Next best action</h2><span>Setup stage</span></div><div class="next"><div class="next-label">RECOMMENDED FIRST STEP</div><h3>Give Contentra context before asking it to create.</h3><p>A useful growth recommendation depends on knowing what you do, who you help, and what you want to achieve.</p><button class="text-button" data-go="brand">Set up your brand →</button></div></section>
            </div>
          </section>
          <section class="page-view" data-page="brand"><div class="heading-row"><div><div class="eyebrow">FOUNDATION</div><h1>Brand Brain</h1><p class="sub">A reusable source of truth for your brand. This preview form shows the intended structure; it does not save to an account yet.</p></div></div><section class="panel"><div class="panel-head"><h2>Brand profile setup</h2><span>Preview form</span></div><form id="brand-form" class="quick-actions"><label style="font-size:11px;font-weight:700">Brand or creator name<input name="brandName" required placeholder="e.g. Your brand" style="display:block;width:100%;margin-top:7px;padding:12px;border:1px solid #e4e4e7;border-radius:8px"></label><label style="font-size:11px;font-weight:700">What do you do?<textarea name="offer" required placeholder="Describe your content, business, or offer" style="display:block;width:100%;margin-top:7px;padding:12px;border:1px solid #e4e4e7;border-radius:8px;min-height:85px;resize:vertical"></textarea></label><label style="font-size:11px;font-weight:700">Who is your audience?<input name="audience" required placeholder="Who do you want to reach?" style="display:block;width:100%;margin-top:7px;padding:12px;border:1px solid #e4e4e7;border-radius:8px"></label><label style="font-size:11px;font-weight:700">Primary goal<select name="goal" style="display:block;width:100%;margin-top:7px;padding:12px;border:1px solid #e4e4e7;border-radius:8px;background:#fff"><option>Grow my audience</option><option>Generate leads or sales</option><option>Build authority</option><option>Publish consistently</option><option>Manage content for clients</option></select></label><button class="primary" type="submit">Preview completed profile</button><p id="form-result" class="sub" aria-live="polite"></p></form></section></section>
          <section class="page-view" data-page="discover"><div class="heading-row"><div><div class="eyebrow">IDEAS WITH INTENTION</div><h1>Discover</h1><p class="sub">Explore ideas and angles worth researching before you spend time creating them.</p></div></div><div class="panel"><div class="empty"><div class="empty-mark">⌕</div><b>Discovery is not connected yet</b><p>In the real product, this area will use your niche, audience context, and supported trend sources to surface relevant opportunities.</p><button class="primary" data-go="brand">Start with Brand Brain</button></div></div></section>
          <section class="page-view" data-page="create"><div class="heading-row"><div><div class="eyebrow">MAKE SOMETHING USEFUL</div><h1>Create</h1><p class="sub">A creation workspace built around your brand context, content format, and goal.</p></div></div><div class="panel"><div class="empty"><div class="empty-mark">✳</div><b>Creation is not connected yet</b><p>The planned workflow will turn a brief into editable drafts and variations using your approved brand context.</p><button class="primary" data-go="brand">Set up your brand first</button></div></div></section>
          <section class="page-view" data-page="content"><div class="heading-row"><div><div class="eyebrow">YOUR WORK, ORGANIZED</div><h1>My Content</h1><p class="sub">A central library for drafts, approved posts, campaign assets, and repurposed content.</p></div></div><div class="panel"><div class="empty"><div class="empty-mark">▤</div><b>Your library is waiting</b><p>Saved content will appear here once creation and persistent storage are implemented.</p></div></div></section>
          <section class="page-view" data-page="planner"><div class="heading-row"><div><div class="eyebrow">CONSISTENCY WITHOUT CHAOS</div><h1>Planner</h1><p class="sub">Plan upcoming content, organize campaigns, and track what is ready to publish.</p></div></div><div class="panel"><div class="empty"><div class="empty-mark">▦</div><b>No calendar connected</b><p>Scheduling and publishing require a working content store and supported platform integrations.</p></div></div></section>
          <section class="page-view" data-page="analytics"><div class="heading-row"><div><div class="eyebrow">LEARN FROM THE WORK</div><h1>Analytics</h1><p class="sub">Understand what resonates and use verified performance data to choose your next move.</p></div></div><div class="panel"><div class="empty"><div class="empty-mark">↗</div><b>Connect data before drawing conclusions</b><p>Analytics will remain empty until account connections, permissions, and real reporting data are available.</p></div></div></section>
          <section class="page-view" data-page="settings"><div class="heading-row"><div><div class="eyebrow">WORKSPACE PREFERENCES</div><h1>Settings</h1><p class="sub">Manage workspace preferences, account details, integrations, and plan settings.</p></div></div><div class="panel"><div class="empty"><div class="empty-mark">⚙</div><b>Settings are preview-only</b><p>Authentication, plan billing, and connected account management have not been implemented.</p></div></div></section>
        </div>
      </main>
    </div>
    <script>
      const navButtons = [...document.querySelectorAll("[data-view]")];
      const pages = [...document.querySelectorAll("[data-page]")];
      const crumb = document.querySelector("#crumb-current");
      const sidebar = document.querySelector("#sidebar");
      const mobileMenu = document.querySelector("#mobile-menu");
      function showView(name) {
        const selected = navButtons.find((button) => button.dataset.view === name);
        if (!selected) return;
        navButtons.forEach((button) => button.classList.toggle("active", button === selected));
        pages.forEach((page) => page.classList.toggle("active", page.dataset.page === name));
        crumb.textContent = selected.textContent.trim();
        sidebar.classList.remove("open");
        mobileMenu.setAttribute("aria-expanded", "false");
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
      navButtons.forEach((button) => button.addEventListener("click", () => showView(button.dataset.view)));
      document.querySelectorAll("[data-go]").forEach((button) => button.addEventListener("click", () => showView(button.dataset.go)));
      mobileMenu.addEventListener("click", () => {
        const open = sidebar.classList.toggle("open");
        mobileMenu.setAttribute("aria-expanded", String(open));
      });
      document.querySelector("#brand-form").addEventListener("submit", (event) => {
        event.preventDefault();
        const data = new FormData(event.currentTarget);
        document.querySelector("#form-result").textContent = "Preview profile created for " + data.get("brandName") + ". Nothing has been saved to an account.";
      });
    </script>
  </body>
</html>
