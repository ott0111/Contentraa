---
import Base from "@/layouts/Base.astro";
import config from "@/config/config.json";

const email = config.params.email;
---

<Base
  title="Get Early Access to Contentra"
  meta_title="Get Early Access | Contentra"
  description="Contact Contentra to follow development and ask about early access."
>
  <section class="page-hero pb-14 pt-16">
    <div class="container">
      <div class="mx-auto max-w-[640px] text-center">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.16em] text-primary">Early access</p>
        <h1 class="mb-6">Be part of what we’re building.</h1>
        <p class="text-lg">Contentra’s full workspace and account system are still in development. We’re not accepting self-serve signups yet, but you can reach out to follow progress and ask about early access.</p>
        <a class="btn btn-primary mt-8" href={`mailto:${email}?subject=Contentra%20Early%20Access`}>Request early access</a>
        <p class="mt-6 text-sm text-text-light">Already have questions? <a class="underline" href="/contact">Contact us</a>.</p>
      </div>
    </div>
  </section>
</Base>