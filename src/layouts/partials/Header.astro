---
const { pathname } = Astro.url;
const links = [
  { label: "Platform", href: "/#platform" },
  { label: "Features", href: "/#features" },
  { label: "For teams", href: "/#who-its-for" },
  { label: "Pricing", href: "/#pricing" },
];
---
<header class="cr-header">
  <nav class="cr-header-inner" aria-label="Main navigation">
    <a class="cr-wordmark" href="/" aria-label="Contentra home">
      <span class="cr-wordmark-icon">c</span><span>contentra</span>
    </a>
    <button class="cr-menu-toggle" type="button" aria-expanded="false" aria-controls="cr-main-menu" aria-label="Open navigation menu">
      <span></span><span></span>
    </button>
    <div class="cr-header-menu" id="cr-main-menu">
      <div class="cr-header-links">
        {links.map((link) => <a href={link.href} class:list={[{ "cr-nav-current": pathname === link.href }, "cr-header-link"]}>{link.label}</a>)}
      </div>
      <div class="cr-header-actions">
        <a class="cr-signin-link" href="/signin">Sign in</a>
        <a class="cr-header-cta" href="/signup">Get started <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </nav>
</header>
<style is:global>
  .cr-header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.94);backdrop-filter:blur(14px);border-bottom:1px solid #eeeeef}
  .cr-header-inner{width:min(1160px,calc(100% - 48px));height:76px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:30px}
  .cr-wordmark{display:inline-flex;align-items:center;gap:9px;color:#18181b;text-decoration:none;font-size:21px;font-weight:800;letter-spacing:-.065em;white-space:nowrap}
  .cr-wordmark-icon{width:30px;height:30px;display:grid;place-items:center;background:#f47b20;border-radius:9px;color:white;font-size:23px;line-height:1;font-weight:800;letter-spacing:-.08em}
  .cr-header-menu,.cr-header-links,.cr-header-actions{display:flex;align-items:center}
  .cr-header-menu{flex:1;justify-content:space-between;gap:24px}
  .cr-header-links{gap:7px;margin-left:auto;margin-right:auto}
  .cr-header-link{font-size:12px;font-weight:600;color:#65656c;text-decoration:none;padding:10px 13px;border-radius:8px;transition:background .15s,color .15s}
  .cr-header-link:hover,.cr-header-link:focus-visible{background:#fff2e8;color:#bd5b0d}
  .cr-header-actions{gap:19px;white-space:nowrap}
  .cr-signin-link{font-size:12px;font-weight:700;color:#38383e;text-decoration:none}
  .cr-signin-link:hover{color:#d76816}
  .cr-header-cta{display:inline-flex;align-items:center;gap:12px;padding:12px 15px;border-radius:9px;background:#f47b20;color:#fff;text-decoration:none;font-size:12px;font-weight:750;transition:background .15s}
  .cr-header-cta:hover{background:#df6814;color:#fff}
  .cr-menu-toggle{display:none;background:#fff;border:1px solid #e8e8eb;border-radius:8px;width:40px;height:40px;padding:11px;cursor:pointer}
  .cr-menu-toggle span{display:block;height:2px;background:#25252a;margin:4px 0;border-radius:4px}
  @media(max-width:760px){.cr-header-inner{height:66px;width:calc(100% - 32px);flex-wrap:wrap;gap:0}.cr-menu-toggle{display:block}.cr-header-menu{display:none;position:absolute;top:65px;left:0;right:0;background:#fff;border-bottom:1px solid #ececef;padding:15px 16px 20px;box-shadow:0 16px 22px #00000008}.cr-header-menu.cr-menu-open{display:flex;flex-direction:column;align-items:stretch;gap:18px}.cr-header-links,.cr-header-actions{flex-direction:column;align-items:stretch;gap:4px;margin:0}.cr-header-link{padding:12px}.cr-header-actions{border-top:1px solid #eee;padding-top:14px;gap:13px}.cr-signin-link{padding:7px 12px}.cr-header-cta{justify-content:center}.cr-menu-toggle[aria-expanded="true"] span:first-child{transform:translateY(3px) rotate(45deg)}.cr-menu-toggle[aria-expanded="true"] span:last-child{transform:translateY(-3px) rotate(-45deg)}}
  @media(min-width:761px){.cr-header-menu{display:flex!important}}
</style>
<script>
  const toggle = document.querySelector<HTMLButtonElement>(".cr-menu-toggle");
  const menu = document.querySelector<HTMLElement>("#cr-main-menu");
  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!expanded));
    toggle.setAttribute("aria-label", expanded ? "Open navigation menu" : "Close navigation menu");
    menu?.classList.toggle("cr-menu-open", !expanded);
  });
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.setAttribute("aria-label", "Open navigation menu");
      menu.classList.remove("cr-menu-open");
    });
  });
</script>